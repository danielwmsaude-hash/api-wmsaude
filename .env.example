# Valores ilustrativos. Copie para .env e troque. NUNCA suba o .env para o GitHub.
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
NEXUS_ENVIRONMENT=development
# Gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Em desenvolvimento pode ficar vazio (segredo temporário). Em produção é obrigatório.
NEXUS_JWT_SECRET=
NEXUS_CORS_ORIGINS=["http://localhost:5173"]
